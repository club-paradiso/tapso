# TAPSO marketing site — apps/web
#
# Copy to `apps/web/.env` for local development, or set the same names as
# Vercel project environment variables for production. Never commit real values.
#
# The site builds and runs with none of these set. In that state the waitlist
# endpoint answers `503 unavailable` and the form says so; it does not pretend
# a registration was stored.

# ---------------------------------------------------------------------------
# PUBLIC / CLIENT SAFE
# ---------------------------------------------------------------------------
# Anything prefixed with VITE_ is compiled into the browser bundle, so nothing
# secret may ever go here.
#
# There are no VITE_ variables. Whether support payment is open is a server
# fact the browser asks for at /api/support/config; a client flag could not make
# an unconfigured merchant account able to take money. The page's support
# section shows "결제 준비 중" until that endpoint answers `live`.

# ---------------------------------------------------------------------------
# SERVER ONLY — read inside apps/web/api, never bundled
# ---------------------------------------------------------------------------

# Supabase project that stores waitlist registrations.
# The service role key bypasses row level security. Treat it like a root password.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend transactional email. The sending domain must be verified first.
RESEND_API_KEY=
# Must use a verified domain, e.g. "TAPSO 탑서 <hello@your-domain>".
WAITLIST_FROM_EMAIL=
# Optional. Where a visitor's reply — including a deletion request — arrives.
WAITLIST_REPLY_TO=

# Identifies which consent text a visitor agreed to. Bump it whenever the
# consent copy in WaitlistForm.tsx changes. Defaults to 2026-08-26.
PRIVACY_CONSENT_VERSION=

# ---------------------------------------------------------------------------
# OPTIONAL DEVELOPMENT / TUNING
# ---------------------------------------------------------------------------
# Anti-abuse limits. Defaults are shown; leave unset unless abuse appears.
# WAITLIST_BURST_LIMIT=3
# WAITLIST_BURST_WINDOW_SECONDS=60
# WAITLIST_RATE_LIMIT=8
# WAITLIST_RATE_LIMIT_WINDOW_SECONDS=3600
# Submissions faster than this are treated as automated.
# WAITLIST_MIN_FILL_MS=1200

# ---------------------------------------------------------------------------
# PAYMENT — NOT ENABLED
# ---------------------------------------------------------------------------
# Support payment stays off until SUPPORT_ENABLED is exactly "true" AND both
# Toss keys are present. Either alone is ignored: a half-configured payment path
# is worse than a disabled one.
#
# STATUS: no merchant account exists. Nothing below has ever run against Toss.
# Leave SUPPORT_ENABLED unset and the support section's button opens a sheet
# that honestly says support is not open yet.

# SUPPORT_ENABLED=true

# --- PAYMENT TEST (Toss test keys, from the Toss dashboard) ---
# Test keys begin with test_ck_ / test_sk_ and charge nobody.
# TOSS_CLIENT_KEY=      # publishable; sent to the browser by /api/support/config
# TOSS_SECRET_KEY=      # SECRET. Server only.

# --- PAYMENT PRODUCTION (Toss live keys) ---
# Live keys begin with live_ck_ / live_sk_ and move real money.
# Do not set these until the merchant contract is complete and a test-mode
# payment has been verified end to end.
# TOSS_CLIENT_KEY=
# TOSS_SECRET_KEY=
# Override only for testing against a mock server.
# TOSS_API_BASE_URL=https://api.tosspayments.com

# A TAPSO-defined secret appended to the webhook URL registered with Toss:
#   https://<domain>/api/support/webhook?t=<SUPPORT_WEBHOOK_TOKEN>
# Toss sends no signature on PAYMENT_STATUS_CHANGED, so this is defence in
# depth. The server still re-reads every payment from Toss before recording it.
# SUPPORT_WEBHOOK_TOKEN=

# Amount policy, in whole won. Defaults: 3000,5000,10000 / 1000 / 100000.
# SUPPORT_PRESET_AMOUNTS=3000,5000,10000
# SUPPORT_MIN_AMOUNT=1000
# SUPPORT_MAX_AMOUNT=100000
