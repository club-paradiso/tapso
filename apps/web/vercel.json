{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "api/_lib/**"
    }
  },
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "preview/**": true,
      "release/**": true,
      "staging": true
    }
  }
}
