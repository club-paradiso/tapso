{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD ./ && [ \"$VERCEL_GIT_COMMIT_REF\" = \"main\" ]",
  "github": {
    "silent": true
  },
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "src/**"
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/v1/cities",
      "destination": "/api/v1/cities"
    },
    {
      "source": "/v1/routes",
      "destination": "/api/v1/routes"
    },
    {
      "source": "/v1/stops",
      "destination": "/api/v1/stops"
    },
    {
      "source": "/v1/route-info",
      "destination": "/api/v1/route-info"
    },
    {
      "source": "/v1/vehicles",
      "destination": "/api/v1/vehicles"
    },
    {
      "source": "/v1/matches",
      "destination": "/api/v1/matches"
    },
    {
      "source": "/v1/sessions",
      "destination": "/api/v1/sessions"
    },
    {
      "source": "/v1/sessions/:id/confirm",
      "destination": "/api/v1/session-confirm?sessionId=:id"
    },
    {
      "source": "/v1/sessions/:id/live-activity",
      "destination": "/api/v1/session-live-activity?sessionId=:id"
    },
    {
      "source": "/v1/sessions/:id",
      "destination": "/api/v1/session?sessionId=:id"
    },
    {
      "source": "/operator/snapshot",
      "destination": "/api/operator/snapshot"
    },
    {
      "source": "/operator/analyze",
      "destination": "/api/operator/analyze"
    },
    {
      "source": "/operator/live-activity/tick",
      "destination": "/api/operator/live-activity-tick"
    },
    {
      "source": "/operator/:path*",
      "destination": "/api/not-found"
    },
    {
      "source": "/v1/:path*",
      "destination": "/api/not-found"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "x-content-type-options",
          "value": "nosniff"
        },
        {
          "key": "referrer-policy",
          "value": "no-referrer"
        },
        {
          "key": "strict-transport-security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/operator/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "no-store"
        },
        {
          "key": "x-robots-tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/ride-capture(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "x-robots-tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
