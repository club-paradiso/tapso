# Public Data Portal Decoding key for TAGO. Server-side only, never a client bundle.
# This is the canonical name everywhere, including the Vercel Sensitive variable.
TAGO_SERVICE_KEY=

# Deprecated. The retired name is honoured only outside serverless, so an existing
# local .env.local keeps working; Vercel treats a PUBLIC_ prefix as a public
# framework variable and refuses Sensitive visibility for it, so production ignores
# this name entirely. Rename your local copy and delete this line.
PUBLIC_DATA_SERVICE_KEY=

# Shared provider cache overrides. The 20-second vehicle default is retained after the
# 2026-09-10 Route 365 probe measured a 27.52-second median snapshot-change interval.
# Successful responses carry a CDN s-maxage equal to whatever is set here.
TRANSIT_STOP_TTL_MS=
TRANSIT_VEHICLE_TTL_MS=
TRANSIT_DISCOVERY_TTL_MS=

# Public transit API policy. Defaults: 120 requests per minute per caller (0 disables),
# no browser origin allowed at all, and ride sessions on outside serverless or with the
# redis store (off on serverless with the memory store, which loses rides on scale-out).
# See docs/PRODUCTION_TRANSIT_API.md.
TRANSIT_RATE_LIMIT_PER_MINUTE=
TRANSIT_ALLOWED_ORIGINS=
TRANSIT_SESSIONS_ENABLED=
# Journey-session store: memory (default) or redis, which needs both Upstash values.
TRANSIT_SESSION_STORE=
# Redis key namespace for journey sessions. Leave commented to keep the default
# tapso:journey-session:. Set-but-empty is rejected at boot, not defaulted.
# TRANSIT_SESSION_KEY_PREFIX=tapso:preview:journey-session:
# Upstash REST URL (absolute https) and token (a secret). Read by the transit API with
# TRANSIT_SESSION_STORE=redis, and by the Railway collector (submissions, beta testers).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Automatic vehicle selection. Default false; true is refused while the demonstrated
# matcher readiness is below READY_FOR_BOUNDED_AUTOMATION (/health shows why).
TRANSIT_AUTOMATIC_MATCHING_ENABLED=

# Listen port, default 8787 (local transit API) or 8788 (Railway collector). Leave
# commented: an empty value is not the default.
# PORT=8787
# Railway collector bind address, default 0.0.0.0.
# HOST=0.0.0.0

# Operator-only mobile Ride Capture Controller (docs/RIDE_CAPTURE_CONTROLLER.md).
# Unset means the /operator/* endpoints stay disabled, which is the right state
# for any deployment that is not collecting ride evidence. Minimum 24 characters;
# set it Sensitive on Vercel. Generate with: openssl rand -base64 32
RIDE_CAPTURE_OPERATOR_TOKEN=
# Per-caller ceiling on the operator budget, separate from the public API's.
# 0 disables the limit. Default 30, which is a 5-second poll plus headroom.
RIDE_CAPTURE_OPERATOR_RATE_LIMIT_PER_MINUTE=

# Railway collector only (legacy ride flows). Beta testing, default off; true or 1
# also needs both Upstash values.
BETA_TESTERS_ENABLED=
# Collector Web Push (VAPID) keys; push needs both, and the private key is a secret.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
# VAPID subject, default below. Leave commented: an empty value disables push.
# WEB_PUSH_VAPID_SUBJECT=https://tapso-api.vercel.app

# Production Live Activity push delivery (BLOCKED_BY_CREDENTIALS in the initial build).
# Read by no code: the APNs gateway in services/api/src/apns.ts only throws
# BLOCKED_BY_CREDENTIALS. APNS_BUNDLE_ID is a placeholder, not the app's bundle
# identifier (apps/ios/project.yml).
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=app.tapso.Tapso
APNS_PRIVATE_KEY_PATH=

# Marketing-site waitlist, email, and support payment variables live in
# apps/web/.env.example. They are set on the Vercel project, not here.
