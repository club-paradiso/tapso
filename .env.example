# Public Data Portal service key. Keep it server-side.
PUBLIC_DATA_SERVICE_KEY=

# Live transit adapter. Keep b551982 as the default until broader TAGO coverage is validated.
# For the verified Jeju pilot use: TRANSIT_PROVIDER=tago
TRANSIT_PROVIDER=b551982

# B551982 resource 15157601 base URL; override only for testing.
PUBLIC_DATA_BASE_URL=https://apis.data.go.kr/B551982/rte

# Official Ministry of Land, Infrastructure and Transport TAGO service bases.
TAGO_ROUTE_BASE_URL=https://apis.data.go.kr/1613000/BusRouteInfoInqireService
TAGO_LOCATION_BASE_URL=https://apis.data.go.kr/1613000/BusLcInfoInqireService

# Shared provider cache overrides. The 20-second vehicle default is retained after the
# 2026-09-10 Route 365 probe measured a 27.52-second median snapshot-change interval.
TRANSIT_STOP_TTL_MS=
TRANSIT_VEHICLE_TTL_MS=

# Backward-compatible B551982-specific cache overrides.
PUBLIC_DATA_STOP_TTL_MS=
PUBLIC_DATA_VEHICLE_TTL_MS=

# Production Live Activity push delivery (BLOCKED_BY_CREDENTIALS in the initial build).
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=app.tapso.Tapso
APNS_PRIVATE_KEY_PATH=

# Marketing-site waitlist, email, and support payment variables live in
# apps/web/.env.example. They are set on the Vercel project, not here.
