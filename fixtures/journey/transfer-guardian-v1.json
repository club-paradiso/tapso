{
  "//": "SPECIFICATION, SYNTHETIC times. Transfer Guardian v1 cases, written by hand from docs/product/JEJU_SAFETY_LAYER_V3.md (Transfer Guardian). Times are minutes after the case's 'now'; a range is what the evidence allows, never a single guessed instant. Both services/api (src/journeySafety.ts) and the Swift core (JourneySafety.swift) run every case.",
  "policy": { "safeMarginMinutes": 4, "longWaitMinutes": 30 },
  "cases": [
    { "id": "T1", "why": "four or more minutes even in the worst case is safe",
      "input": { "feederArrival": { "min": 6, "max": 9 }, "walk": 2, "connection": { "min": 18, "max": 20 }, "nextConnection": 48 },
      "expect": { "risk": "safe", "worstMargin": 7, "bestMargin": 12, "waitIfMissed": 40, "reasons": ["longWaitIfMissed"] } },
    { "id": "T2", "why": "makeable in the worst case, with under four minutes, is tight",
      "input": { "feederArrival": { "min": 6, "max": 9 }, "walk": 2, "connection": { "min": 13, "max": 15 }, "nextConnection": 30 },
      "expect": { "risk": "tight", "worstMargin": 2, "bestMargin": 7, "waitIfMissed": 22, "reasons": [] } },
    { "id": "T3", "why": "makeable only if things go well is at risk",
      "input": { "feederArrival": { "min": 6, "max": 12 }, "walk": 2, "connection": { "min": 12, "max": 14 }, "nextConnection": 54 },
      "expect": { "risk": "atRisk", "worstMargin": -2, "bestMargin": 6, "waitIfMissed": 46, "reasons": ["longWaitIfMissed"] } },
    { "id": "T4", "why": "not makeable even in the best case is missed",
      "input": { "feederArrival": { "min": 10, "max": 12 }, "walk": 3, "connection": { "min": 8, "max": 11 }, "nextConnection": 41 },
      "expect": { "risk": "missed", "worstMargin": -7, "bestMargin": -2, "waitIfMissed": 28, "reasons": [] } },
    { "id": "T5", "why": "no estimate for the bus the rider is on is unknown, never safe",
      "input": { "feederArrival": null, "walk": 2, "connection": { "min": 18, "max": 20 }, "nextConnection": 48 },
      "expect": { "risk": "unknown", "worstMargin": null, "bestMargin": null, "waitIfMissed": null, "reasons": ["feederUnknown"] } },
    { "id": "T6", "why": "no estimate for the connecting bus is unknown",
      "input": { "feederArrival": { "min": 6, "max": 9 }, "walk": 2, "connection": null, "nextConnection": null },
      "expect": { "risk": "unknown", "worstMargin": null, "bestMargin": null, "waitIfMissed": null, "reasons": ["connectionUnknown"] } },
    { "id": "T7", "why": "a recovery plan replaces the connection",
      "input": { "feederArrival": { "min": 10, "max": 12 }, "walk": 3, "connection": { "min": 8, "max": 11 }, "nextConnection": 41, "recovering": true },
      "expect": { "risk": "recovering", "worstMargin": null, "bestMargin": null, "waitIfMissed": null, "reasons": [] } },
    { "id": "T8", "why": "a range whose minimum exceeds its maximum is not evidence",
      "input": { "feederArrival": { "min": 9, "max": 6 }, "walk": 2, "connection": { "min": 18, "max": 20 }, "nextConnection": 48 },
      "expect": { "risk": "unknown", "worstMargin": null, "bestMargin": null, "waitIfMissed": null, "reasons": ["invalidInput"] } },
    { "id": "T9", "why": "exactly four minutes in the worst case is safe",
      "input": { "feederArrival": { "min": 5, "max": 5 }, "walk": 0, "connection": { "min": 9, "max": 9 }, "nextConnection": null },
      "expect": { "risk": "safe", "worstMargin": 4, "bestMargin": 4, "waitIfMissed": null, "reasons": [] } },
    { "id": "T10", "why": "exactly zero minutes in the worst case is tight",
      "input": { "feederArrival": { "min": 5, "max": 7 }, "walk": 1, "connection": { "min": 8, "max": 10 }, "nextConnection": null },
      "expect": { "risk": "tight", "worstMargin": 0, "bestMargin": 4, "waitIfMissed": null, "reasons": [] } },
    { "id": "T11", "why": "a negative walk is not a measurement",
      "input": { "feederArrival": { "min": 5, "max": 7 }, "walk": -1, "connection": { "min": 8, "max": 10 }, "nextConnection": null },
      "expect": { "risk": "unknown", "worstMargin": null, "bestMargin": null, "waitIfMissed": null, "reasons": ["invalidInput"] } },
    { "id": "T12", "why": "a following bus that leaves before the rider can be ready is no fallback",
      "input": { "feederArrival": { "min": 10, "max": 12 }, "walk": 3, "connection": { "min": 8, "max": 11 }, "nextConnection": 12 },
      "expect": { "risk": "missed", "worstMargin": -7, "bestMargin": -2, "waitIfMissed": null, "reasons": [] } }
  ]
}
