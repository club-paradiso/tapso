{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "TAPSO Design System V3 Tokens",
  "version": "3.0.0",
  "description": "Canonical token manifest for TAPSO V3 (basalt). Authoritative implementation truth from apps/ios/Shared/TapsoTokens.swift.",
  "license": "SIL OFL 1.1 (Pretendard), MIT / Proprietary (TAPSO)",
  "color": {
    "background": {
      "primary": { "light": "#FFFFFF", "dark": "#0F171A", "role": "Main screen surface" },
      "secondary": { "light": "#F3F5F4", "dark": "#172124", "role": "Shore surface: cards, rows, fields" },
      "elevated": { "light": "#FFFFFF", "dark": "#1F2B2F", "role": "Elevated modal/confirmation surfaces" }
    },
    "text": {
      "primary": { "light": "#0F171A", "dark": "#EEF2F1", "role": "Basalt ink / primary headlines and labels" },
      "secondary": { "light": "#56636A", "dark": "#A9B6BA", "role": "Stone: supporting copy, timestamps" },
      "tertiary": { "light": "#5C686E", "dark": "#8C999E", "role": "Hints, placeholders, chevrons" },
      "onAccent": { "light": "#0F171A", "dark": "#0F171A", "role": "Text on mint, amber, tangerine, blue fills" },
      "onUrgent": { "light": "#FFFFFF", "dark": "#0F171A", "role": "Text on next-stop coral fill" },
      "onDarkSurface": { "light": "#FFFFFF", "dark": "#FFFFFF", "role": "Text on Lock Screen basalt and Dynamic Island" }
    },
    "separator": {
      "default": { "light": "#E1E6E4", "dark": "#2A373B", "role": "Dividers, hairline strokes, outlines" }
    },
    "journey": {
      "active": { "light": "#2FC7AA", "dark": "#2FC7AA", "role": "Riding / normal progress" },
      "prepare": { "light": "#F4B84A", "dark": "#F4B84A", "role": "Two stops remaining / preparation" },
      "next": { "light": "#C93C3C", "dark": "#FF7A6E", "role": "Next stop / urgent get-off alert" },
      "arrival": { "light": "#F7972F", "dark": "#F7972F", "role": "Arrival moment / destination indicator" },
      "checking": { "light": "#4389EF", "dark": "#5B9BFF", "role": "Signal disagreement / bus awaiting confirmation" },
      "degraded": { "light": "#8A9AA3", "dark": "#9FB0B8", "role": "Delayed, lost, offline telemetry" }
    },
    "trust": {
      "vehicleConfirmed": { "light": "#2FC7AA", "dark": "#2FC7AA" },
      "vehicleNeedsConfirmation": { "light": "#4389EF", "dark": "#5B9BFF" },
      "dataLive": { "light": "#2FC7AA", "dark": "#2FC7AA" },
      "dataDelayed": { "light": "#F4B84A", "dark": "#F4B84A" }
    },
    "identity": {
      "tangerine": { "light": "#F7972F", "dark": "#F7972F", "role": "Destination marker, hair pin" },
      "dolCheek": { "light": "#FF7A6E", "dark": "#FF7A6E", "role": "Dori blushing cheeks" },
      "basalt": { "light": "#0F171A", "dark": "#0F171A", "role": "Identity pebble fill, dark base" },
      "basaltRaised": { "light": "#1A2528", "dark": "#1A2528", "role": "Raised basalt layers" },
      "mintDeep": { "light": "#097666", "dark": "#2FC7AA", "role": "High-contrast mint ink on light Shore surfaces" }
    }
  },
  "space": {
    "xxs": 4,
    "xs": 8,
    "sm": 12,
    "md": 16,
    "lg": 20,
    "xl": 24,
    "xxl": 32,
    "gutter": 20
  },
  "radius": {
    "sm": 12,
    "control": 14,
    "md": 18,
    "lg": 24,
    "hero": 28,
    "pill": 999
  },
  "size": {
    "minimumTouch": 44,
    "primaryButtonHeight": 56,
    "routeBadgeHeight": 30
  },
  "typography": {
    "app": {
      "family": "Pretendard 1.3.9",
      "license": "SIL OFL 1.1",
      "scope": "App target only",
      "weights": ["Regular", "SemiBold", "ExtraBold"]
    },
    "extensions": {
      "family": "SF Pro Rounded / System",
      "scope": "Live Activity and Share extensions",
      "reason": "Extension memory budget and rendering stability without custom font loading"
    },
    "heroNumeral": {
      "baseSize": 76,
      "maxSize": 120,
      "tabularDigits": true
    }
  },
  "motion": {
    "standard": { "curve": "easeInOut", "durationSeconds": 0.25 },
    "emphasis": { "type": "spring", "response": 0.38, "dampingFraction": 0.82 },
    "reduceMotion": "Nullify springs, crossfade poses, disable continuous animation, jump rail marker"
  }
}
